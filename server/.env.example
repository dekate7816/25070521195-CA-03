# Looply Backend Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection (Atlas or local)
# Example Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
# Example Local: mongodb://localhost:27017/looply_app
MONGODB_URI=mongodb://localhost:27017/looply_app
DB_NAME=looply_app

# Client URL (for CORS allowlist)
CLIENT_URL=http://localhost:5173

# Session Cookie Configuration
SESSION_COOKIE_NAME=looply_session
SESSION_SECRET=replace_with_a_secure_random_string_in_production
SESSION_MAX_AGE_DAYS=14

# Google OAuth 2.0 / OpenID Connect (Optional until configured)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
